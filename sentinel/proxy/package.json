{
  "name": "@sentinelproxy/proxy",
  "version": "1.0.0",
  "private": true,
  "description": "SentinelProxy reverse-proxy guardrail in front of DVAA agents (T2). Zero dependencies.",
  "type": "module",
  "main": "server.mjs",
  "bin": { "sentinel-proxy": "./cli.mjs" },
  "exports": {
    ".": "./server.mjs",
    "./server": "./server.mjs",
    "./inspectors": "./inspectors.mjs",
    "./default-inspectors": "./default-inspectors.mjs",
    "./capture-sink": "./capture-sink.mjs"
  },
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node cli.mjs",
    "bench": "node bench/latency.mjs",
    "test": "node --test \"test/*.test.mjs\""
  }
}
